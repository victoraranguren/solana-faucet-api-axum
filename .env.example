# Clave privada de la wallet distribuidora del Faucet en formato Base58
FAUCET_SECRET_KEY="tu_clave_privada_base58_aqui"

# URL del nodo RPC de Solana (Devnet por defecto)
RPC_URL="https://api.devnet.solana.com"

# Puerto en el que escuchará el servidor API REST
PORT="3000"

# Cantidad de lamports a enviar por solicitud (1 SOL = 1,000,000,000 Lamports. Ejemplo: 100,000 Lamports = 0.0001 SOL)
AIRDROP_AMOUNT_LAMPORTS="100000"
